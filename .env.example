# ====================================================================== #
# WisPay environment configuration                                        #
#                                                                          #
# Driver selection (BE-1):                                                #
#   1. WS_DB_URL — when set, takes precedence.                            #
#      Examples:                                                          #
#        WS_DB_URL=sqlite:///wispay.db              # local dev            #
#        WS_DB_URL=sqlite:///:memory:               # ephemeral test       #
#        WS_DB_URL=mssql+pyodbc://...               # Azure SQL (prod)     #
#   2. AZURE_SQL_* env vars — when populated, the Azure SQL path is used. #
#   3. Neither set → dev default (sqlite:///wispay.db).                   #
# ====================================================================== #

# --- Database (canonical knob; uncomment + edit to override default) --- #
# WS_DB_URL=sqlite:///wispay.db

# --- Azure SQL (production; install with `uv sync --extra azure`) --- #
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USERNAME=your-sql-username
AZURE_SQL_PASSWORD=replace-with-your-local-password
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no
AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=your-database-name;Uid=your-sql-username;Pwd=replace-with-your-local-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# --- Azure Document Intelligence --- #
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-local-key

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_API_KEY=replace-with-your-local-key

# --- Microsoft Entra ID (corporate SSO — ADR-0007; install with `uv sync --extra entra`) --- #
AZURE_ENTRA_TENANT_ID=your-directory-tenant-id
AZURE_ENTRA_CLIENT_ID=your-application-client-id
AZURE_ENTRA_CLIENT_SECRET=replace-with-your-local-secret-value
AZURE_ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
